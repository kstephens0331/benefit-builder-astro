---
interface Props {
  src?: string;
  poster?: string;
  caption?: string;
  size?: "full" | "half" | "quarter";
  class?: string;
}
const {
  src = "/images/benefit_builder_final.mp4",
  poster = "/images/workplace-stone.svg",
  caption,
  size = "full",
  class: className = "",
} = Astro.props;
const wrap = size === "quarter" ? "w-full md:w-1/4" : size === "half" ? "w-full md:w-1/2" : "w-full";
---

<div class={`${wrap} ${className}`.trim()}>
  <figure class="rounded-2xl overflow-hidden border border-brand-stone bg-white">
    <video controls playsinline preload="metadata" poster={poster} class="w-full h-auto block" aria-label="Services explainer video">
      <source src={src} type="video/mp4" />
    </video>
    {caption && <figcaption class="px-5 py-3 text-sm text-brand-charcoal/80 border-t border-brand-stone">{caption}</figcaption>}
  </figure>
</div>
