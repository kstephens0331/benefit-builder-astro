---
interface Props {
  title?: string;
  kicker?: string;
  id?: string;
  narrow?: boolean;
  bg?: "default" | "sand" | "white" | "stone";
}
const { title, kicker, id, narrow, bg = "default" } = Astro.props;
const bgClass = bg === "sand" ? "bg-brand-sand/50" : bg === "white" ? "bg-white" : bg === "stone" ? "bg-brand-stone/50" : "";
---

<section id={id} class={`${bgClass} border-b border-brand-stone/60`}>
  <div class={`mx-auto ${narrow ? "max-w-3xl" : "max-w-7xl"} px-4 sm:px-6 lg:px-8 py-14`}>
    {kicker && <p class="text-sm tracking-wide uppercase text-brand-green font-semibold">{kicker}</p>}
    {title && <h2 class="font-heading text-3xl text-brand-navy mt-1">{title}</h2>}
    <div
      class={`${title ? "mt-6" : ""} prose prose-neutral max-w-none prose-headings:font-heading prose-headings:text-brand-navy prose-p:text-brand-charcoal/90 prose-a:text-brand-green prose-strong:text-brand-charcoal`}
    >
      <slot />
    </div>
  </div>
</section>
