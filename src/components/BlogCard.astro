---
import type { BlogMeta } from "../lib/blog/posts";
import { formatDateUTC } from "../lib/blog/markdown";
interface Props {
  post: BlogMeta;
}
const { post } = Astro.props;
// data-* attributes power the vanilla blog search/filter on /blog.
const haystack = `${post.title} ${post.excerpt} ${post.tags.join(" ")}`.toLowerCase();
---

<a
  href={`/blog/${post.slug}`}
  class="blog-filterable group flex flex-col overflow-hidden rounded-lg border border-brand-stone bg-white transition hover:border-brand-green hover:shadow-md"
  data-tags={post.tags.join("|").toLowerCase()}
  data-text={haystack}
>
  <img src={post.image.replace(/\.png$/, ".webp")} alt={post.title} loading="lazy" width="1200" height="630" class="aspect-[1200/630] w-full object-cover" />
  <div class="flex flex-1 flex-col p-5">
    <div class="flex flex-wrap gap-2">
      {post.tags.slice(0, 2).map((t) => <span class="text-xs font-semibold uppercase tracking-wide text-brand-green">{t}</span>)}
    </div>
    <h3 class="mt-1 font-heading text-lg text-brand-navy group-hover:underline">{post.title}</h3>
    <p class="mt-2 flex-1 text-sm text-brand-charcoal/90">{post.excerpt}</p>
    <span class="mt-3 text-xs text-brand-charcoal/70">{formatDateUTC(post.date)}</span>
  </div>
</a>
