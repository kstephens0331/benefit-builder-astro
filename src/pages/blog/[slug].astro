---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CTARow from "../../components/CTARow.astro";
import BlogCard from "../../components/BlogCard.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { getAllSlugs, getPost, getRelatedPosts } from "../../lib/blog/posts";
import { extractHeadings, readTimeMinutes, formatDateUTC } from "../../lib/blog/markdown";
import { markdownToHtml } from "../../lib/markdownToHtml";
import { article, webPage, breadcrumbList } from "../../lib/seo/jsonld";

export function getStaticPaths() {
  return getAllSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = getPost(slug || "")!;
const path = `/blog/${post.slug}`;
const url = `https://benefitbuilderllc.com${path}`;
const headings = extractHeadings(post.body);
const readTime = readTimeMinutes(post.body);
const bodyHtml = markdownToHtml(post.body);
const displayImage = post.image.replace(/\.png$/, ".webp"); // WebP for on-page display; PNG stays the OG image
const related = getRelatedPosts(post.slug, 3);
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Blog", href: "/blog" },
  { name: post.title, href: path },
];
const breadcrumb = breadcrumbList(crumbs);
const jsonLd = [
  article({ headline: post.title, description: post.excerpt, url, datePublished: post.date, image: post.image }),
  webPage({ name: post.title, description: post.excerpt, url, breadcrumb }),
  breadcrumb,
];
---

<Base title={post.title} description={post.excerpt} path={path} image={post.image} imageAlt={post.title} type="article" preloadImage={displayImage} jsonLd={jsonLd}>
  <Breadcrumbs crumbs={crumbs} />

  <article class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <a href="/blog" class="text-sm font-medium text-brand-green hover:underline">Back to all articles</a>

    <div class="mt-4 flex flex-wrap gap-2">
      {post.tags.slice(0, 2).map((t) => <span class="text-xs font-semibold uppercase tracking-wide text-brand-green">{t}</span>)}
    </div>
    <h1 class="mt-2 max-w-3xl font-heading text-3xl text-brand-navy md:text-4xl">{post.title}</h1>
    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-brand-charcoal/70">
      <span>{formatDateUTC(post.date)}</span>
      <span>{readTime} min read</span>
    </div>

    <img src={displayImage} alt={post.title} width="1200" height="630" fetchpriority="high" class="mt-6 aspect-[1200/630] w-full rounded-xl border border-brand-stone object-cover" />

    <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_260px]">
      <div class="min-w-0">
        <div class="bb-prose" set:html={bodyHtml} />
        <div class="mt-12 border-t border-brand-stone pt-8">
          <CTARow primaryLabel="Estimate your savings" primaryTo="/savings-calculator" secondaryTo="/contact" secondaryLabel="Contact us" />
        </div>
      </div>

      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-6">
          <TableOfContents headings={headings} />
          <div class="rounded-lg border border-brand-stone bg-brand-sand/40 p-5">
            <div class="font-heading text-brand-navy">Run your numbers</div>
            <p class="mt-1 text-sm text-brand-charcoal/90">See the savings for your team in seconds.</p>
            <a href="/savings-calculator" class="mt-3 inline-flex rounded-md bg-brand-green px-4 py-2 text-sm font-semibold text-white hover:opacity-90">Open the calculator</a>
          </div>
        </div>
      </aside>
    </div>

    {
      related.length > 0 && (
        <div class="mt-16 border-t border-brand-stone pt-10">
          <h2 class="font-heading text-2xl text-brand-navy">Related articles</h2>
          <div class="mt-6 grid gap-6 md:grid-cols-3">
            {related.map((p) => (
              <BlogCard post={p} />
            ))}
          </div>
        </div>
      )
    }
  </article>
</Base>
