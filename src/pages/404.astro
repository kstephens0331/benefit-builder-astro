---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page Not Found | Benefit Builder LLC"
  description="The page you requested does not exist or may have moved."
  path="/404"
  noindex={true}
>
  <div class="flex flex-col items-center justify-center min-h-[60vh] px-6 text-center">
    <h1 class="text-6xl font-bold text-brand-green mb-4">404</h1>
    <h2 class="text-2xl font-semibold text-brand-charcoal mb-2">Page Not Found</h2>
    <p class="text-brand-charcoal/70 mb-8 max-w-md">The page you are looking for does not exist or may have moved.</p>
    <a href="/" class="bg-brand-green hover:opacity-90 text-white font-semibold px-6 py-3 rounded-lg transition">Back to Home</a>
  </div>
</Base>
