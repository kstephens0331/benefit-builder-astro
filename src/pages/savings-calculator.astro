---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { findRoute } from "../lib/seo/routes";
import { webApplication, webPage, breadcrumbList } from "../lib/seo/jsonld";
import { STATE_OPTIONS, computeSavings, EMPLOYEE_FEE_RATE, EMPLOYER_FEE_RATE } from "../lib/tax/savings2026";

const r = findRoute("/savings-calculator")!;
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Savings Calculator", href: "/savings-calculator" },
];
const breadcrumb = breadcrumbList(crumbs);
const jsonLd = [
  webApplication({
    name: "Section 125 Savings Calculator",
    description: r.description,
    url: `https://benefitbuilderllc.com${r.path}`,
    applicationCategory: "FinanceApplication",
  }),
  webPage({ name: r.title, description: r.description, url: `https://benefitbuilderllc.com${r.path}`, breadcrumb }),
  breadcrumb,
];

// Server-rendered initial result so numbers are correct before JS runs.
const SEC125_MONTHLY = 800;
const PERIODS: Record<string, number> = { weekly: 52, biweekly: 26, semimonthly: 24, monthly: 12 };
function calc(employees: number, avgGross: number, frequency: string, stateCode: string) {
  const periods = PERIODS[frequency];
  const annualGrossPerEmployee = avgGross * periods;
  const monthlyPretax = annualGrossPerEmployee / 12 >= SEC125_MONTHLY ? SEC125_MONTHLY : 0;
  return computeSavings({ employees, annualGrossPerEmployee, annualPretaxPerEmployee: monthlyPretax * 12, stateCode });
}
const init = calc(50, 2500, "biweekly", "TX");
const fmtUSD = (n: number) => new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(Math.round(n));
const fmtPct = (n: number) => `${(n * 100).toFixed(1)}%`;
---

<Base title={r.title} description={r.description} path={r.path} image={r.ogImage} jsonLd={jsonLd}>
  <Breadcrumbs crumbs={crumbs} />

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <p class="text-sm uppercase tracking-wide text-brand-green font-semibold">Savings calculator</p>
    <h1 class="font-heading text-4xl md:text-5xl text-brand-navy mt-2">Estimate Your Section 125 Savings</h1>
    <p class="mt-4 max-w-3xl text-brand-charcoal/90 text-lg">
      Enter your headcount, average gross pay, pay frequency, and state. We show the estimated annual savings for both
      the employer and employees, net of our 8% administration fee. No signup required.
    </p>
  </section>

  <section class="bg-white border-y border-brand-stone">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 grid gap-10 lg:grid-cols-2">
      <form class="space-y-5" id="calcForm" aria-label="Savings calculator inputs">
        <div>
          <label for="employees" class="block text-sm font-semibold text-brand-charcoal">Number of enrolled employees</label>
          <input id="employees" type="number" min="1" value="50" class="mt-2 w-full rounded border border-brand-stone bg-white px-3 py-2" />
        </div>
        <div>
          <label for="avgGross" class="block text-sm font-semibold text-brand-charcoal">Average gross pay per period</label>
          <input id="avgGross" type="number" min="0" step="50" value="2500" class="mt-2 w-full rounded border border-brand-stone bg-white px-3 py-2" />
        </div>
        <div>
          <label for="frequency" class="block text-sm font-semibold text-brand-charcoal">Pay frequency</label>
          <select id="frequency" class="mt-2 w-full rounded border border-brand-stone bg-white px-3 py-2">
            <option value="weekly">Weekly (52 periods)</option>
            <option value="biweekly" selected>Bi-weekly (26 periods)</option>
            <option value="semimonthly">Semi-monthly (24 periods)</option>
            <option value="monthly">Monthly (12 periods)</option>
          </select>
        </div>
        <div>
          <label for="state" class="block text-sm font-semibold text-brand-charcoal">State</label>
          <select id="state" class="mt-2 w-full rounded border border-brand-stone bg-white px-3 py-2">
            {STATE_OPTIONS.map((s) => <option value={s.code} selected={s.code === "TX"}>{s.name}</option>)}
          </select>
        </div>
      </form>

      <div class="rounded-lg border border-brand-stone bg-brand-sand/30 p-6">
        <h2 class="font-heading text-2xl text-brand-navy">Estimated annual savings</h2>
        <p class="mt-1 text-sm text-brand-charcoal/70">
          Net of the 8% administration fee ({fmtPct(EMPLOYEE_FEE_RATE)} employee, {fmtPct(EMPLOYER_FEE_RATE)} employer).
          Estimates assume single filing status with 0 dependents.
        </p>
        <dl class="mt-6 space-y-4">
          <div class="flex items-baseline justify-between gap-4">
            <dt class="text-sm text-brand-charcoal/80">Employee tax savings rate (FICA + federal + state)</dt>
            <dd id="rEmployeeRate" class="text-base text-brand-charcoal">{fmtPct(init.employeeTaxRate)}</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4">
            <dt class="text-sm text-brand-charcoal/80">Employer net savings (total team)</dt>
            <dd id="rEmployerNet" class="text-2xl font-bold text-brand-green">{fmtUSD(init.employerNetTeam)}</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4">
            <dt class="text-sm text-brand-charcoal/80">Employee net savings (total team)</dt>
            <dd id="rEmployeeNet" class="text-2xl font-bold text-brand-green">{fmtUSD(init.employeeNetTeam)}</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4">
            <dt class="text-sm text-brand-charcoal/80">Net combined savings (total team)</dt>
            <dd id="rCombined" class="text-2xl font-bold text-brand-green">{fmtUSD(init.netCombinedTeam)}</dd>
          </div>
        </dl>
        <p class="mt-6 text-xs text-brand-charcoal/70">
          Estimate. The employee figure uses the 7.65% FICA rate plus a single-filer federal marginal rate and your
          state income tax rate for 2026; the employer figure uses the 7.65% FICA rate. Both are shown net of our 8%
          administration fee. Actual results vary with filing status, dependents, the Social Security wage base ($184,500
          for 2026), and local taxes. Contact us for a precise quote tailored to your roster.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-brand-sand/30 border-b border-brand-stone" aria-label="Email my estimate">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 grid gap-10 lg:grid-cols-5 items-start">
      <div class="lg:col-span-2">
        <h2 class="font-heading text-2xl text-brand-navy">Want this estimate in writing?</h2>
        <p class="mt-3 text-brand-charcoal/90">
          We will email you the numbers from this calculator and follow up with a precise, roster-tailored quote within
          one business day. No obligation.
        </p>
        <ul class="mt-4 space-y-2 text-sm text-brand-charcoal/90 list-disc pl-5">
          <li>Your estimated employer FICA savings.</li>
          <li>The employee take-home impact.</li>
          <li>Our all-inclusive monthly fee, in plain numbers.</li>
        </ul>
      </div>
      <div class="lg:col-span-3">
        <div
          id="leadNotice"
          role="status"
          aria-live="polite"
          tabindex="-1"
          class="mb-4 hidden rounded-xl border border-brand-green bg-brand-green/10 p-4 focus:outline-none"
        >
          <p class="font-semibold text-brand-navy">Thank you -- your estimate is on the way.</p>
          <p class="mt-1 text-sm text-brand-charcoal/90">
            We will email it shortly and follow up within one business day. If it is urgent, call
            <a class="underline decoration-brand-stone hover:text-brand-navy" href="tel:+18172965547">(817) 296-5547</a>.
          </p>
        </div>
        <form id="leadForm" class="grid gap-4" novalidate>
          <div class="hidden">
            <label for="lead_company_website">Company website</label>
            <input id="lead_company_website" name="company_website" autocomplete="off" tabindex="-1" />
          </div>
          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label class="text-sm font-medium text-brand-navy" for="lead_name">Full name</label>
              <input id="lead_name" name="name" class="mt-1 w-full rounded-lg border border-brand-stone bg-white px-3 py-2" />
              <p id="lead-err-name" class="mt-1 hidden text-sm text-red-700"></p>
            </div>
            <div>
              <label class="text-sm font-medium text-brand-navy" for="lead_company">Company</label>
              <input id="lead_company" name="company" class="mt-1 w-full rounded-lg border border-brand-stone bg-white px-3 py-2" />
            </div>
          </div>
          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label class="text-sm font-medium text-brand-navy" for="lead_email">Work email</label>
              <input id="lead_email" name="email" type="email" class="mt-1 w-full rounded-lg border border-brand-stone bg-white px-3 py-2" />
              <p id="lead-err-email" class="mt-1 hidden text-sm text-red-700"></p>
            </div>
            <div>
              <label class="text-sm font-medium text-brand-navy" for="lead_phone">Phone (optional)</label>
              <input id="lead_phone" name="phone" type="tel" class="mt-1 w-full rounded-lg border border-brand-stone bg-white px-3 py-2" />
            </div>
          </div>
          <div>
            <label class="text-sm font-medium text-brand-navy" for="lead_note">Anything specific? (optional)</label>
            <textarea id="lead_note" name="note" rows="2" class="mt-1 w-full rounded-lg border border-brand-stone bg-white px-3 py-2"></textarea>
          </div>
          <div class="mt-1 flex items-center gap-4">
            <button type="submit" class="inline-flex items-center rounded-md bg-brand-green text-white font-semibold px-6 py-3 hover:opacity-90 disabled:opacity-60">
              Email my estimate
            </button>
            <p id="leadError" class="hidden text-sm text-red-700"></p>
          </div>
          <p class="text-xs text-brand-charcoal/80">
            By submitting, you agree to be contacted about your request. We respect your privacy and will not share your
            details.
          </p>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  import { computeSavings } from "../lib/tax/savings2026";
  const SEC125_MONTHLY = 800;
  const PERIODS = { weekly: 52, biweekly: 26, semimonthly: 24, monthly: 12 };
  const fmtUSD = (n) => new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(Math.round(n));
  const fmtPct = (n) => `${(n * 100).toFixed(1)}%`;
  const $ = (id) => document.getElementById(id);

  // Latest computed estimate, so the lead form can attach it to the inquiry.
  let last = null;

  function update() {
    const employees = Math.max(1, Number($("employees").value) || 0);
    const avgGross = Math.max(0, Number($("avgGross").value) || 0);
    const frequency = $("frequency").value;
    const stateCode = $("state").value;
    const stateName = $("state").selectedOptions[0]?.textContent || stateCode;
    const annualGrossPerEmployee = avgGross * PERIODS[frequency];
    const monthlyPretax = annualGrossPerEmployee / 12 >= SEC125_MONTHLY ? SEC125_MONTHLY : 0;
    const r = computeSavings({ employees, annualGrossPerEmployee, annualPretaxPerEmployee: monthlyPretax * 12, stateCode });
    $("rEmployeeRate").textContent = fmtPct(r.employeeTaxRate);
    $("rEmployerNet").textContent = fmtUSD(r.employerNetTeam);
    $("rEmployeeNet").textContent = fmtUSD(r.employeeNetTeam);
    $("rCombined").textContent = fmtUSD(r.netCombinedTeam);
    last = {
      employees,
      avgGross,
      frequency,
      stateName,
      employerNetTeam: r.employerNetTeam,
      employeeNetTeam: r.employeeNetTeam,
      netCombinedTeam: r.netCombinedTeam,
    };
  }

  const form = document.getElementById("calcForm");
  form?.addEventListener("submit", (e) => e.preventDefault());
  ["employees", "avgGross", "frequency", "state"].forEach((id) => {
    const el = document.getElementById(id);
    el?.addEventListener("input", update);
    el?.addEventListener("change", update);
  });
  update(); // populate `last` with the initial estimate

  // Lead capture: posts to the existing /api/contact mailer with the current
  // estimate attached. Honeypot + elapsed-time bot checks mirror the contact form.
  const leadForm = document.getElementById("leadForm");
  if (leadForm) {
    const start = Date.now();
    const notice = document.getElementById("leadNotice");
    const errBox = document.getElementById("leadError");
    const submitBtn = leadForm.querySelector('button[type="submit"]');
    const emailRe = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
    const setErr = (id, msg) => {
      const el = document.getElementById(id);
      if (el) {
        el.textContent = msg || "";
        el.classList.toggle("hidden", !msg);
      }
    };

    leadForm.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      if (errBox) errBox.classList.add("hidden");
      const fd = new FormData(leadForm);
      const name = String(fd.get("name") || "").trim();
      const email = String(fd.get("email") || "").trim();
      const company = String(fd.get("company") || "").trim();
      const phone = String(fd.get("phone") || "").trim();
      const note = String(fd.get("note") || "").trim();
      const honeypot = String(fd.get("company_website") || "");

      let ok = true;
      setErr("lead-err-name", name.length >= 2 ? "" : "Please enter your name.");
      if (name.length < 2) ok = false;
      setErr("lead-err-email", emailRe.test(email) ? "" : "Enter a valid email.");
      if (!emailRe.test(email)) ok = false;
      if (honeypot) return; // bot
      if (!ok) return;

      const l = last || {};
      const message =
        "Savings calculator lead.\n" +
        `Inputs: ${l.employees} enrolled employees, ${fmtUSD(l.avgGross)} avg gross/period (${l.frequency}), ${l.stateName}.\n` +
        `Estimated annual, net of 8% fee: employer ${fmtUSD(l.employerNetTeam)}, employees ${fmtUSD(l.employeeNetTeam)}, combined ${fmtUSD(l.netCombinedTeam)}.` +
        (note ? `\n\nNote: ${note}` : "");

      submitBtn.disabled = true;
      submitBtn.textContent = "Sending...";
      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name,
            company,
            email,
            phone,
            message,
            honeypot,
            elapsedMs: Date.now() - start,
            cf_turnstile_response: "",
          }),
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json && json.ok) {
          leadForm.reset();
          leadForm.classList.add("hidden");
          if (notice) {
            notice.classList.remove("hidden");
            notice.scrollIntoView({ behavior: "smooth", block: "start" });
            notice.focus();
          }
        } else if (errBox) {
          errBox.textContent = (json && json.error) || "Something went wrong sending your request. Please try again.";
          errBox.classList.remove("hidden");
        }
      } catch (e) {
        if (errBox) {
          errBox.textContent = "Network error. Please try again.";
          errBox.classList.remove("hidden");
        }
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Email my estimate";
      }
    });
  }
</script>
