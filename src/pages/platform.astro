---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CTARow from "../components/CTARow.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { findRoute } from "../lib/seo/routes";
import { service, webPage, breadcrumbList } from "../lib/seo/jsonld";

const r = findRoute("/platform")!;
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Platform", href: "/platform" },
];
const breadcrumb = breadcrumbList(crumbs);
const jsonLd = [
  service({
    name: "Benefit Builder Administration Platform",
    description: r.description,
    url: `https://benefitbuilderllc.com${r.path}`,
    serviceType: "Section 125 benefits administration platform",
  }),
  webPage({ name: r.title, description: r.description, url: `https://benefitbuilderllc.com${r.path}`, breadcrumb }),
  breadcrumb,
];

const clientSteps = [
  {
    title: "Send us your census",
    body: "Share your employee census at setup, and again whenever your team changes. That is the information we need to build and run your plan. We accept it in whatever format your payroll already produces.",
  },
  {
    title: "Sign the agreements",
    body: "Review and electronically sign your plan documents and agreements. We prepare each one for you and explain what it covers, so there is nothing to draft or research on your end.",
  },
  {
    title: "Verify your roster on the 20th",
    body: "Once a month we send your current roster for a quick review. You confirm it by the 20th. That is your entire monthly commitment to keeping the plan accurate and compliant.",
  },
];

const handledForYou = [
  {
    title: "Accurate pre-tax deductions",
    body: "We calculate the correct pre-tax amount for every participant, so the deductions on your payroll stay right pay period after pay period.",
  },
  {
    title: "Plan documents, prepared and current",
    body: "Your Section 125 plan document, adoption agreement, and salary reduction forms are drafted, signed, and kept up to date as your plan or the rules change.",
  },
  {
    title: "Nondiscrimination testing",
    body: "We run the required nondiscrimination testing each plan year to keep your plan qualified, and flag anything that needs attention while there is still time to act.",
  },
  {
    title: "Billing handled on our side",
    body: "Your monthly billing and the bookkeeping behind it happen on our platform. You receive one clear invoice. You never log into an accounting system.",
  },
  {
    title: "Secure, audit-ready records",
    body: "Every signed document and plan record is stored securely and kept audit-ready, so if your plan is ever reviewed the paperwork is already in order.",
  },
];
---

<Base title={r.title} description={r.description} path={r.path} image={r.ogImage} preloadImage="/images/home-lower-1.webp" jsonLd={jsonLd}>
  <Breadcrumbs crumbs={crumbs} />

  <section class="relative overflow-hidden border-b border-brand-stone/60 min-h-[380px]" aria-label="Platform hero">
    <img src="/images/home-lower-1.webp" alt="A team collaborating in a modern office" class="absolute inset-0 h-full w-full object-cover object-center" loading="eager" fetchpriority="high" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-b from-black/45 via-black/30 to-transparent"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 md:py-16">
      <h1 class="font-heading text-white drop-shadow text-4xl md:text-5xl">A Platform That Runs Your Plan For You</h1>
      <p class="mt-4 max-w-3xl text-white/90 text-lg">
        We built and run our own platform so your Section 125 plan is handled from end to end. You send us a census, sign
        the agreements, and verify your roster each month. We take care of everything else.
      </p>
      <div class="mt-6">
        <CTARow primaryLabel="Talk to an expert" primaryTo="/contact" secondaryTo="/services" secondaryLabel="See services" />
      </div>
    </div>
  </section>

  {/* WHAT YOU DO -- the client's entire role */}
  <section class="bg-white border-b border-brand-stone" aria-label="What you do">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 grid gap-10 lg:grid-cols-2 items-center">
      <div>
        <p class="text-sm tracking-wide uppercase text-brand-green font-semibold">Your part is simple</p>
        <h2 class="font-heading text-3xl text-brand-navy mt-2">Three things on your side. We handle the rest.</h2>
        <p class="mt-4 text-brand-charcoal/90">
          A Section 125 plan has a lot of moving parts. Almost none of them land on you. Your team has three
          responsibilities, and Benefit Builder carries everything else.
        </p>
        <ol class="mt-6 space-y-5">
          {
            clientSteps.map((s, i) => (
              <li class="flex gap-4">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-green text-white font-bold">{i + 1}</span>
                <div>
                  <h3 class="font-heading text-lg text-brand-navy">{s.title}</h3>
                  <p class="mt-1 text-brand-charcoal/90">{s.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <ResponsiveImage src="/images/platform-collaboration.webp" alt="An employer reviewing their monthly roster" width={1200} height={800} />
      </div>
    </div>
  </section>

  {/* HANDLED FOR YOU -- benefit framing, no internal mechanics */}
  <section class="bg-brand-sand/40 border-b border-brand-stone" aria-label="What we handle">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 grid gap-10 md:grid-cols-2 items-center">
      <div>
        <p class="text-sm tracking-wide uppercase text-brand-green font-semibold">Handled for you</p>
        <h2 class="font-heading text-3xl text-brand-navy mt-2">Everything else runs behind the scenes</h2>
        <p class="mt-4 text-brand-charcoal/90">
          Once your plan is set up, the day-to-day administration happens on our platform, not on your desk. You will
          never reconcile a ledger or chase a filing deadline. Here is what we keep running for you.
        </p>
        <ul class="mt-6 space-y-4">
          {
            handledForYou.map((h) => (
              <li>
                <h3 class="font-heading text-lg text-brand-navy">{h.title}</h3>
                <p class="mt-1 text-brand-charcoal/90">{h.body}</p>
              </li>
            ))
          }
        </ul>
        <div class="mt-8">
          <CTARow primaryLabel="See how it works" primaryTo="/contact" secondaryTo="/compliance" secondaryLabel="Compliance details" />
        </div>
      </div>
      <div>
        <ResponsiveImage src="/images/platform-dashboard.webp" alt="Benefit Builder keeps every plan record in one place" width={1200} height={800} />
      </div>
    </div>
  </section>

  {/* WHY OUR OWN PLATFORM -- trust, high level */}
  <section class="bg-white border-b border-brand-stone" aria-label="Built in-house">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 grid gap-10 md:grid-cols-2 items-center">
      <div class="order-2 md:order-1">
        <p class="text-sm tracking-wide uppercase text-brand-green font-semibold">Built and run in-house</p>
        <h2 class="font-heading text-3xl text-brand-navy mt-2">Your plan runs on software we own, not a reseller's</h2>
        <div class="prose prose-neutral max-w-none mt-5 text-brand-charcoal/90">
          <p>
            Most administrators license another company's software and pass the cost and the limitations on to you. We
            built our own platform and run it ourselves. Your roster, Social Security numbers, and pay data stay inside a
            system we control, and access is limited to the people who need it.
          </p>
          <p>
            Your agreements are signed electronically and kept to ESIGN and UETA standards, with a clear record of who
            signed and when. And when a regulation changes, we make the change ourselves instead of waiting in a vendor's
            support queue.
          </p>
        </div>
        <div class="mt-6">
          <CTARow primaryLabel="Talk to an expert" primaryTo="/contact" secondaryTo="/compliance" secondaryLabel="How we stay compliant" />
        </div>
      </div>
      <div class="order-1 md:order-2">
        <ResponsiveImage src="/images/platform-security.webp" alt="Your plan records are kept secure and audit-ready" width={1200} height={800} />
      </div>
    </div>
  </section>

  {/* WHY IT MATTERS TO YOU */}
  <section class="bg-brand-sand/40 border-b border-brand-stone" aria-label="Why it matters">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
      <p class="text-sm tracking-wide uppercase text-brand-green font-semibold">What it means for you</p>
      <h2 class="font-heading text-3xl text-brand-navy mt-2">Why building it ourselves matters</h2>
      <div class="mt-10 grid gap-8 md:grid-cols-3 text-brand-charcoal/90">
        <div class="rounded-lg border border-brand-stone bg-white p-6">
          <h3 class="font-heading text-xl text-brand-navy">No third-party administrator fees</h3>
          <p class="mt-3">We do not pay an outside administrator to run your plan, so that cost is not built into what you pay us. Your fee covers the full service, not a markup on someone else's product.</p>
        </div>
        <div class="rounded-lg border border-brand-stone bg-white p-6">
          <h3 class="font-heading text-xl text-brand-navy">Faster fixes and changes</h3>
          <p class="mt-3">When a rule changes or something needs improving, we ship the change ourselves. You are not waiting on a vendor for a fix that affects your savings or your filing deadlines.</p>
        </div>
        <div class="rounded-lg border border-brand-stone bg-white p-6">
          <h3 class="font-heading text-xl text-brand-navy">Tighter control of your data</h3>
          <p class="mt-3">Your roster, Social Security numbers, and payroll figures stay within a system we control. No outside vendor holds that data, which keeps the security boundary clear and accountable.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-brand-navy" aria-label="Final call to action">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <h2 class="font-heading text-2xl text-white">Ready to hand off the administration?</h2>
        <p class="text-white/85 mt-1">We will walk you through exactly what we handle and what stays on your side.</p>
      </div>
      <div><CTARow primaryLabel="Talk to an expert" primaryTo="/contact" /></div>
    </div>
  </section>
</Base>
