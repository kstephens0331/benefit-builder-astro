---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CTARow from "../components/CTARow.astro";
import { findRoute } from "../lib/seo/routes";
import { faqPage, webPage, breadcrumbList } from "../lib/seo/jsonld";
import { GENERAL_FAQS } from "../lib/faq/faqs";

const r = findRoute("/faq")!;
const path = "/faq";
const url = `https://benefitbuilderllc.com${path}`;
const crumbs = [
  { name: "Home", href: "/" },
  { name: "FAQ", href: path },
];
const breadcrumb = breadcrumbList(crumbs);
const jsonLd = [
  faqPage(GENERAL_FAQS.map((f) => ({ question: f.question, answer: f.answer }))),
  webPage({ name: r.title, description: r.description, url, breadcrumb }),
  breadcrumb,
];

// Preserve category order as authored in the bank.
const categories: string[] = [];
for (const f of GENERAL_FAQS) if (!categories.includes(f.category)) categories.push(f.category);
---

<Base title={r.title} description={r.description} path={path} image={r.ogImage} jsonLd={jsonLd}>
  <Breadcrumbs crumbs={crumbs} />

  <section class="relative overflow-hidden border-b border-brand-stone/60 bg-brand-navy py-16">
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm uppercase tracking-wide text-brand-sand font-semibold">Frequently asked questions</p>
      <h1 class="font-heading text-white drop-shadow text-4xl md:text-5xl mt-2">Section 125 Plan FAQ</h1>
      <p class="mt-4 max-w-3xl text-white/90 text-lg">
        Plain answers to the questions employers ask most about Section 125 cafeteria plans: what they are, what is
        included, what they cost, and how a plan gets set up and run.
      </p>
      <div class="mt-6">
        <CTARow primaryLabel="Get a quote" primaryTo="/contact" secondaryTo="/savings-calculator" secondaryLabel="Estimate your plan" />
      </div>
    </div>
  </section>

  {
    categories.map((cat) => (
      <section class="bg-white border-b border-brand-stone">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
          <h2 class="font-heading text-2xl text-brand-navy">{cat}</h2>
          <div class="mt-5 grid gap-4 md:grid-cols-2">
            {
              GENERAL_FAQS.filter((f) => f.category === cat).map((qa) => (
                <details class="group rounded-xl border border-brand-stone bg-white open:shadow-sm">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-5 py-4">
                    <span class="font-semibold text-brand-charcoal">{qa.question}</span>
                    <svg class="h-5 w-5 text-brand-green transition-transform group-open:rotate-45" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path d="M9 3h2v14H9z" />
                      <path d="M3 9h14v2H3z" />
                    </svg>
                  </summary>
                  <div class="px-5 pb-5 text-brand-charcoal/90">{qa.answer}</div>
                </details>
              ))
            }
          </div>
        </div>
      </section>
    ))
  }

  <section class="bg-brand-navy" aria-label="Final call to action">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <h2 class="font-heading text-2xl text-white">Still have a question?</h2>
        <p class="text-white/85 mt-1">Talk to a Texas-based team. Quotes within one business day.</p>
      </div>
      <div><CTARow primaryLabel="Contact us" primaryTo="/contact" secondaryTo="/industries" secondaryLabel="Plans by industry" /></div>
    </div>
  </section>
</Base>
