---
import Base from "../layouts/Base.astro";
import CTARow from "../components/CTARow.astro";
import ProcessTimeline from "../components/ProcessTimeline.astro";
import TestimonialsBand from "../components/TestimonialsBand.astro";
import CtaBand from "../components/CtaBand.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { findRoute } from "../lib/seo/routes";
import { organization, localBusiness, website, webPage, person, financialService } from "../lib/seo/jsonld";

const r = findRoute("/")!;
const jsonLd = [
  organization(),
  person(),
  localBusiness(),
  financialService(),
  website(),
  webPage({ name: r.title, description: r.description, url: "https://benefitbuilderllc.com/" }),
];
---

<Base
  title={r.title}
  description={r.description}
  path={r.path}
  image={r.ogImage}
  preloadImage="/images/benefit-builder-home-hero.webp"
  jsonLd={jsonLd}
>
  {/* HERO (static for fast LCP) */}
  <section class="relative overflow-hidden border-b border-brand-stone/60 min-h-[520px]">
    <img
      src="/images/benefit-builder-home-hero.webp"
      alt="A professional team collaborating in a modern office"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/25 to-transparent"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 md:py-20">
      <h1 class="font-heading text-white drop-shadow text-4xl md:text-5xl">Where Benefits Meet Growth</h1>
      <p class="mt-2 max-w-2xl text-white/90 text-lg">
        We help leaders offer benefits people understand, with a rollout that is simple for HR and sustainable for the
        business.
      </p>
      <CTARow primaryLabel="Talk to an expert" secondaryTo="/services#video" secondaryLabel="Watch the 90-120s overview" />
    </div>
  </section>

  {/* VALUE PROPOSITION */}
  <section class="relative bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid gap-10 md:grid-cols-5 items-center">
        <div class="md:col-span-2 animate-rise">
          <ResponsiveImage src="/images/workplace-stone.webp" alt="Abstract workplace texture" class="bg-brand-stone/50" />
        </div>
        <div class="md:col-span-3 animate-rise">
          <p class="text-sm tracking-wide uppercase text-brand-green font-semibold">Why it matters</p>
          <h2 class="font-heading text-3xl text-brand-navy mt-2">Benefits that raise confidence and reduce friction</h2>
          <div class="prose prose-neutral max-w-none mt-5">
            <p class="text-brand-charcoal/90">
              Teams want clarity and protection. Leaders need cost control, recruiting strength, and less complexity. Our
              approach improves employee understanding and participation while keeping the rollout straightforward for HR.
            </p>
            <ul>
              <li>Employees: practical coverage with plain-language guidance.</li>
              <li>Leaders: predictable outcomes and a stronger employer brand.</li>
              <li>HR: streamlined enrollment, communications, and renewals.</li>
            </ul>
          </div>
          <CTARow primaryLabel="Explore services" primaryTo="/services" secondaryTo="/contact" secondaryLabel="Ask a question" />
        </div>
      </div>
    </div>
  </section>

  {/* OUTCOMES BAND */}
  <section class="relative border-y border-brand-stone bg-brand-navy" aria-label="Typical outcomes">
    <div class="absolute inset-0 opacity-20 pointer-events-none">
      <img src="/images/workplace-stone.webp" class="w-full h-full object-cover" alt="" />
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
      <h2 class="font-heading text-2xl text-white">What organizations gain</h2>
      <div class="mt-6 grid gap-8 sm:grid-cols-3">
        <div>
          <div class="text-3xl font-bold text-brand-sand">Recruiting Edge</div>
          <p class="text-white/85 mt-2">A clearer benefits story helps candidates choose you and encourages current talent to stay.</p>
        </div>
        <div>
          <div class="text-3xl font-bold text-brand-sand">Participation</div>
          <p class="text-white/85 mt-2">Simple choices and guided education lead to higher adoption of the plans that matter most.</p>
        </div>
        <div>
          <div class="text-3xl font-bold text-brand-sand">Cost Confidence</div>
          <p class="text-white/85 mt-2">A design focused on real-world gaps helps control exposure and creates more predictable costs over time.</p>
        </div>
      </div>
    </div>
  </section>

  {/* SPOTLIGHT */}
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 grid gap-10 md:grid-cols-2 items-start">
      <div>
        <p class="text-sm tracking-wide uppercase text-brand-green font-semibold">Spotlight</p>
        <h3 class="font-heading text-3xl text-brand-navy mt-2">A smarter path to stronger benefits</h3>
        <div class="prose prose-neutral max-w-none mt-5">
          <p class="text-brand-charcoal/90">
            We tailor supplemental options like life, accident, critical illness, disability, and gap protection to
            complement your existing coverage. The goal: protection employees value, with a rollout that is simple to
            manage.
          </p>
          <ul>
            <li>Clear communication and guided enrollment.</li>
            <li>High-signal options that fill the real gaps.</li>
            <li>Ongoing support for renewals and vendor reviews.</li>
          </ul>
        </div>
        <div class="mt-6">
          <CTARow primaryLabel="See how it works" primaryTo="/services#video" secondaryTo="/contact" secondaryLabel="Request a quick analysis" />
        </div>
      </div>
      <div>
        <ResponsiveImage src="/images/spotlight.webp" alt="Benefits spotlight illustration" />
      </div>
    </div>
  </section>

  {/* PHOTO BREAK 1 */}
  <section class="bg-brand-sand/40 border-y border-brand-stone" aria-label="Lower feature 1">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 grid gap-10 md:grid-cols-2 items-center">
      <div>
        <ResponsiveImage src="/images/home-lower-1.webp" alt="Team collaboration" class="shadow-md" />
      </div>
      <div>
        <h3 class="font-heading text-2xl text-brand-navy">Collaboration that works</h3>
        <p class="mt-4 text-brand-charcoal/90">
          Our process ensures HR, leadership, and employees stay aligned. With clear communication and ongoing support,
          benefits become a shared strength instead of a stress point.
        </p>
        <div class="mt-6">
          <CTARow primaryLabel="See our approach" primaryTo="/services" secondaryTo="/contact" secondaryLabel="Talk to us" />
        </div>
      </div>
    </div>
  </section>

  <ProcessTimeline />

  {/* LOWER FEATURE 2 */}
  <section class="bg-white border-y border-brand-stone" aria-label="Lower feature 2">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 grid gap-10 md:grid-cols-2 items-center">
      <div class="order-2 md:order-1">
        <h3 class="font-heading text-2xl text-brand-navy">Practical support, year-round</h3>
        <p class="mt-4 text-brand-charcoal/90">
          From renewal reviews to compliance check-ins, we help organizations maintain momentum. Support is baked into
          the process, not left as an afterthought.
        </p>
        <div class="mt-6">
          <CTARow primaryLabel="Get support" primaryTo="/contact" secondaryTo="/services" secondaryLabel="Explore services" />
        </div>
      </div>
      <div class="order-1 md:order-2">
        <ResponsiveImage src="/images/home-lower-2.webp" alt="Overhead desk collaboration" class="shadow-md" />
      </div>
    </div>
  </section>

  <TestimonialsBand />
  <CtaBand />
</Base>
