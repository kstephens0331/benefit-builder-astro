---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CTARow from "../../components/CTARow.astro";
import { findRoute } from "../../lib/seo/routes";
import { service, faqPage, webPage, breadcrumbList, itemList, type FaqQa } from "../../lib/seo/jsonld";
import { INDUSTRIES, type IndustryLoc } from "../../lib/industries/industries";
import { INDUSTRY_GENERAL_SUBSET } from "../../lib/faq/faqs";

export async function getStaticPaths() {
  return INDUSTRIES.map((i) => ({ params: { industry: i.slug }, props: { industry: i } }));
}

const { industry } = Astro.props as { industry: IndustryLoc };
const path = `/industries/${industry.slug}`;
const r = findRoute(path)!;
const url = `https://benefitbuilderllc.com${path}`;
const crumbs = [
  { name: "Home", href: "/" },
  { name: "Industries", href: "/industries" },
  { name: industry.name, href: path },
];
const breadcrumb = breadcrumbList(crumbs);
// Industry-specific questions first, then the most-asked general Section 125
// questions, so each page has a robust FAQ (~13) led by its unique content.
const faqs: FaqQa[] = [
  ...industry.faq,
  ...INDUSTRY_GENERAL_SUBSET.map((f) => ({ question: f.question, answer: f.answer })),
];
const others = INDUSTRIES.filter((i) => i.slug !== industry.slug);
const jsonLd = [
  service({
    name: `Section 125 Cafeteria Plan Administration for ${industry.name}`,
    description: industry.metaDescription,
    url,
    serviceType: "Section 125 cafeteria plan administration",
  }),
  faqPage(faqs),
  webPage({ name: r.title, description: r.description, url, breadcrumb }),
  breadcrumb,
];
---

<Base title={r.title} description={r.description} path={path} image={r.ogImage} jsonLd={jsonLd}>
  <Breadcrumbs crumbs={crumbs} />

  <section class="relative overflow-hidden border-b border-brand-stone/60 bg-brand-navy py-16">
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm uppercase tracking-wide text-brand-sand font-semibold">For {industry.name} employers</p>
      <h1 class="font-heading text-white drop-shadow text-4xl md:text-5xl mt-2">{industry.h1}</h1>
      <p class="mt-4 max-w-3xl text-white/90 text-lg">{industry.intro}</p>
      <div class="mt-6">
        <CTARow primaryLabel="Get a quote" primaryTo="/contact" secondaryTo="/savings-calculator" secondaryLabel="Estimate your plan" />
      </div>
    </div>
  </section>

  <section class="bg-white border-b border-brand-stone">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 grid gap-10 md:grid-cols-2 items-start">
      <div>
        <p class="text-sm tracking-wide uppercase text-brand-green font-semibold">Why it fits</p>
        <h2 class="font-heading text-3xl text-brand-navy mt-2">Built for {industry.noun}</h2>
        <p class="mt-4 text-brand-charcoal/90">{industry.why}</p>
        <div class="mt-6">
          <CTARow primaryLabel="Talk to us" primaryTo="/contact" secondaryTo="/services/employers" secondaryLabel="For employers" align="left" />
        </div>
      </div>
      <div class="grid gap-4">
        {
          industry.highlights.map((h) => (
            <div class="rounded-lg border border-brand-stone bg-brand-sand/30 p-5">
              <h3 class="font-heading text-lg text-brand-navy">{h.title}</h3>
              <p class="mt-2 text-sm text-brand-charcoal/90">{h.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-brand-sand/40 border-b border-brand-stone">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
      <h2 class="font-heading text-3xl text-brand-navy">What is included</h2>
      <p class="mt-3 max-w-3xl text-brand-charcoal/90">
        For {industry.noun}, a plan is only as good as the administration behind it. Every Section 125 plan we run
        comes with the full set, built around how you hire and pay and bundled into one monthly fee:
      </p>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 text-brand-charcoal/90">
        <li class="rounded-lg border border-brand-stone bg-white p-4">The written Section 125 plan document, drafted to your benefits and pay frequency.</li>
        <li class="rounded-lg border border-brand-stone bg-white p-4">Adoption agreement and per-employee salary reduction forms.</li>
        <li class="rounded-lg border border-brand-stone bg-white p-4">Plain-language enrollment and employee education.</li>
        <li class="rounded-lg border border-brand-stone bg-white p-4">Annual nondiscrimination testing, prepared and filed.</li>
        <li class="rounded-lg border border-brand-stone bg-white p-4">Ongoing administration and payroll coordination.</li>
        <li class="rounded-lg border border-brand-stone bg-white p-4">Texas-based support, with quotes within one business day.</li>
      </ul>
      <div class="mt-6">
        <CTARow primaryLabel="See what is bundled" primaryTo="/compliance" secondaryTo="/savings-calculator" secondaryLabel="Estimate your plan" align="left" />
      </div>
    </div>
  </section>

  <section class="bg-white border-b border-brand-stone">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <h2 class="font-heading text-3xl text-brand-navy">Common questions</h2>
        <a href="/faq" class="text-sm font-semibold text-brand-green hover:underline">See all FAQs &rarr;</a>
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {
          faqs.map((qa) => (
            <details class="group rounded-xl border border-brand-stone bg-white open:shadow-sm">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-5 py-4">
                <span class="font-semibold text-brand-charcoal">{qa.question}</span>
                <svg class="h-5 w-5 text-brand-green transition-transform group-open:rotate-45" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M9 3h2v14H9z" />
                  <path d="M3 9h14v2H3z" />
                </svg>
              </summary>
              <div class="px-5 pb-5 text-brand-charcoal/90">{qa.answer}</div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-brand-sand/30 border-b border-brand-stone" aria-label="Explore more">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
      <h2 class="font-heading text-2xl text-brand-navy">Explore more</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <a href="/services/employers" class="rounded-lg border border-brand-stone bg-white p-4 hover:border-brand-green">
          <span class="font-semibold text-brand-navy">For employers</span>
          <p class="mt-1 text-sm text-brand-charcoal/80">How the plan works and what it costs.</p>
        </a>
        <a href="/savings-calculator" class="rounded-lg border border-brand-stone bg-white p-4 hover:border-brand-green">
          <span class="font-semibold text-brand-navy">Plan calculator</span>
          <p class="mt-1 text-sm text-brand-charcoal/80">Estimate the impact for your team, with client examples.</p>
        </a>
        <a href="/compliance" class="rounded-lg border border-brand-stone bg-white p-4 hover:border-brand-green">
          <span class="font-semibold text-brand-navy">Compliance</span>
          <p class="mt-1 text-sm text-brand-charcoal/80">Plan documents, testing, and audit-ready records.</p>
        </a>
        <a href="/locations" class="rounded-lg border border-brand-stone bg-white p-4 hover:border-brand-green">
          <span class="font-semibold text-brand-navy">Service areas</span>
          <p class="mt-1 text-sm text-brand-charcoal/80">The states and cities we serve.</p>
        </a>
      </div>
      <div class="mt-6">
        <p class="text-sm font-semibold text-brand-navy">Other industries</p>
        <div class="mt-2 flex flex-wrap gap-2">
          {
            others.map((o) => (
              <a href={`/industries/${o.slug}`} class="rounded-full border border-brand-stone bg-white px-3 py-1.5 text-sm text-brand-charcoal hover:border-brand-green hover:text-brand-navy">
                {o.name}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="bg-brand-navy" aria-label="Final call to action">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <h2 class="font-heading text-2xl text-white">Ready to strengthen your benefits?</h2>
        <p class="text-white/85 mt-1">Quotes within one business day. We handle the plan, enrollment, and compliance.</p>
      </div>
      <div><CTARow primaryLabel="Get a quote" primaryTo="/contact" /></div>
    </div>
  </section>
</Base>
